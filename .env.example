# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgres://nestjs:nestjs@localhost:5432/nestjs?schema=public"

# ---------------------------------------------------------------------------
# Gemma PIM POC (PIM_*). Values are read through ConfigService only when first
# needed. Leave EMPTY here: real values live in a git-ignored .env / secret store.
# Supplier (AW/Aiku) and channel (PrestaShop 9, Temu EU) credentials are NOT env
# vars: they are entered in the back office (Settings) and stored encrypted in
# the database with PIM_ENCRYPTION_KEY.
# ---------------------------------------------------------------------------

# base64 of 32 random bytes (AES-256-GCM: credentials + PII at rest). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes every stored credential and order PII unreadable.
PIM_ENCRYPTION_KEY=

# Optional: slug of the tenant the back office acts on (single tenant POC).
PIM_TENANT_SLUG=

# S3-compatible object storage for product images (MinIO in docker-compose:
# endpoint http://localhost:9000, bucket pim-media, credentials = the MinIO root user).
PIM_S3_ENDPOINT=
PIM_S3_REGION=
PIM_S3_BUCKET=
PIM_S3_ACCESS_KEY=
PIM_S3_SECRET_KEY=
# Optional public base URL (CDN) that channels download images from; defaults to <endpoint>/<bucket>.
PIM_S3_PUBLIC_BASE_URL=

# LLM enrichment (FR-ENR-002). Key is also read as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
PIM_LLM_MODEL=
PIM_LLM_BASE_URL=
PIM_LLM_MAX_TOKENS=

# Order routing defaults (FR-AW-006 AC9: used when a channel hides phone/email).
PIM_ORDER_DEFAULT_EMAIL=
PIM_ORDER_DEFAULT_PHONE=
# Fractions, not percentages (0.15 = 15%). Defaults in code: 0.15 and 0.23.
PIM_ORDER_MIN_MARGIN=
PIM_ORDER_VAT_RATE=
PIM_ORDER_SHIPPING_ABSORBED=

# docker-compose only (optional overrides of the MinIO images).
# PIM_MINIO_IMAGE=
# PIM_MINIO_MC_IMAGE=
