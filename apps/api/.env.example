DATABASE_URL="postgres://nestjs:nestjs@localhost:5432/nestjs?schema=public"
PORT="3100"

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"

MONGO_URI="mongodb://nestjs:nestjs@localhost:27017/nestjs?authSource=admin"


CORS_ORIGIN="http://localhost:3000,*"
METRICS_TOKEN=
# Sentry (optional): leave SENTRY_DSN unset to disable.
# SENTRY_DSN=""
# Traces sample rate 0..1 — 0 disables tracing; e.g. 0.1 in production.
# SENTRY_TRACES_SAMPLE_RATE="0"

# PIM runtime (all read lazily; see packages/pim-runtime/src/runtime.constants.ts)
# base64 of 32 random bytes: `openssl rand -base64 32`. Encrypts supplier/channel credentials and order PII.
PIM_ENCRYPTION_KEY=
PIM_TENANT_SLUG=
# S3-compatible object storage (MinIO locally), path-style addressing
PIM_S3_ENDPOINT="http://localhost:9000"
PIM_S3_REGION="us-east-1"
PIM_S3_BUCKET="pim-media"
PIM_S3_ACCESS_KEY=
PIM_S3_SECRET_KEY=
PIM_S3_PUBLIC_BASE_URL=
# LLM (Anthropic Messages API) for PT-PT enrichment
ANTHROPIC_API_KEY=
PIM_LLM_MODEL=
# Defaults sent to the supplier for orders without customer email/phone
PIM_ORDER_DEFAULT_EMAIL=
PIM_ORDER_DEFAULT_PHONE=
PIM_ORDER_MIN_MARGIN="0.15"
PIM_ORDER_VAT_RATE="0.23"
