{
  "name": "@repo/pim-catalog",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/bullmq": "^11.0.5",
    "bullmq": "^5.66.5 || ^6.0.0",
    "rxjs": "^7.8.2"
  },
  "dependencies": {
    "@repo/core-domain": "workspace:*",
    "@repo/connector-contracts": "workspace:*",
    "@repo/http-client": "workspace:*",
    "@repo/connector-aw-aiku": "workspace:*",
    "@repo/connector-prestashop9": "workspace:*",
    "@repo/connector-temu-eu": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "decimal.js": "^10.6.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@nestjs/bullmq": "^11.0.5",
    "bullmq": "^5.66.5",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@repo/(core-domain|connector-contracts|http-client|connector-aw-aiku|connector-prestashop9|connector-temu-eu|pim-catalog|pim-orders)$": "<rootDir>/../../$1/src"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/index.ts",
      "!**/*.module.ts",
      "!**/*.types.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
